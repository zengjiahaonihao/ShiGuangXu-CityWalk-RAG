# 复制为 .env 后填写
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# embedding 策略: auto | local | api
#   auto  -> 优先本地 sentence-transformers，不可用则回退内置 hashing 向量
#   local -> 强制内置 hashing 向量（零依赖、离线可跑）
#   api   -> 调用 OpenAI 兼容的 /embeddings 接口（推荐 bge-m3 / text-embedding-3-small）
EMBEDDING_PROVIDER=auto

# EMBEDDING_PROVIDER=api 时生效
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
